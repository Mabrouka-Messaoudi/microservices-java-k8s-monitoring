# =============================================================================
# Copier ce fichier en scripts/secrets.env puis renseigner les valeurs.
#   cp scripts/secrets.env.example scripts/secrets.env
# scripts/secrets.env est ignoré par Git : ne jamais le commiter.
# =============================================================================

# Identifiants SMTP Mailtrap (inbox de test) utilisés par notification-service
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password

# Utilisateur Keycloak de test utilisé par scripts/test-nexshop.sh
TEST_USERNAME=your-keycloak-test-user
TEST_PASSWORD=your-keycloak-test-password
